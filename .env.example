# =============================================================================
# shizuku-php (雫) — Environment Configuration
# Copy to .env on your shared hosting (e.g. /home/user/shizuku.sitezet.com/.env)
# =============================================================================

# Production public URL (NO trailing slash)
PUBLIC_BASE_URL="https://shizuku.sitezet.com"

# SQLite database path (relative to project root or absolute path)
DATABASE_PATH="data/shizuku.db"
UPLOAD_DIR="data/uploads"

# Long random secret (min 32 chars) — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret-key-at-least-32-chars"

# Initial Admin Studio credentials (only used when AdminUser table is empty)
ADMIN_USERNAME="farhan"
ADMIN_EMAIL="farhansatria.07@gmail.com"
ADMIN_PASSWORD="replace-with-strong-admin-password"

# Set "true" on HTTPS (shizuku.sitezet.com), "false" only on local http://localhost
COOKIE_SECURE="true"

# SHIZUKU Ecosystem CORS & Cross-Subdomain SSO
ECOSYSTEM_ALLOWED_ORIGINS="https://shikas.sitezet.com"
ECOSYSTEM_COOKIE_DOMAIN=".sitezet.com"

# Sign in with Google (OAuth 2.0 Web Client)
# Add https://shizuku.sitezet.com/api/ecosystem/google/callback in Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: environment mode ("production" on hosting, "development" locally)
APP_ENV="production"
